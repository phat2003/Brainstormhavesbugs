@model IEnumerable<CommentVM>

@{
    ViewData["Title"] = "Comment List";
}

<h2>Comment List</h2>

<p>
    <a asp-controller="Comment" asp-action="Create" class="btn btn-primary">Add New Comment</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>User</th>
            <th>Idea</th>
            <th>Content</th>
            <th>Created At</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.comment.Id</td>
                <td>@item.comment.ApplicationUser?.UserName</td>
                <td>@item.idea?.Text</td>
                <td>@item.comment.Text</td>
                <td>@item.comment.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.comment.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.comment.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
